# ============================================================
# Variables de la RAÍZ del monorepo
# ============================================================
#
# ¿DÓNDE VA CADA COSA?
#
#   ESTE archivo (raíz)  → TODO lo que consume Docker: secretos de servicios
#                          externos (Telegram, Groq, OpenRouter, Tavily,
#                          ElevenLabs), infraestructura (Postgres, puertos) y la
#                          configuración de la app en contenedor (DATABASE_URL,
#                          NEXTAUTH_*, AURA_API_KEY, AI_*).
#                          `docker compose` sustituye ${VAR} desde acá.
#
#   Quid-App/.env        → SÓLO para correr Next fuera de contenedores
#                          (`npm run dev`) y para comandos de Prisma en el host.
#                          Docker NO lo lee.
#
# REGLA: una variable de Docker vive ÚNICAMENTE en este archivo. Si la duplicás
# en Quid-App/.env, el valor efectivo depende de un orden de merge que nadie
# recuerda y vas a depurar el equivocado. Esto ya causó un bug: AI_API_KEY
# quedaba vacía porque no estaba acá.

NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000
AUTH_COOKIE_SECURE=false

# Push Notifications VAPID keys
# Generar: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=tu-clave-publica-vapid
VAPID_PRIVATE_KEY=tu-clave-privada-vapid
VAPID_SUBJECT=mailto:tu@email.com

TELEGRAM_BOT_TOKEN=your-token
TELEGRAM_ALLOWED_USER_IDS=123456789
GROQ_API_KEY=your-key
OPENROUTER_API_KEY=your-key
GOOGLE_AI_KEY=your-key
TAVILY_API_KEY=your-key
FIREBASE_SERVICE_ACCOUNT_JSON=your-json
POSTGRES_DB=quid
POSTGRES_USER=quid
POSTGRES_PASSWORD=quid-local-dev
POSTGRES_PORT=5432

# Local PostgreSQL DATABASE_URL used only for migration tests.
# The current app still uses Quid-App/.env while SQLite remains active.
POSTGRES_DATABASE_URL=postgresql://quid:quid-local-dev@localhost:5432/quid?schema=public

# ── Backend de IA ────────────────────────────────────────────
# Ollama se eliminó: agotaba la RAM del servidor y tumbó la máquina. Ahora se usa
# un router OpenAI-compatible (FreeLLMAPI). Ver Quid-App/src/lib/ai/llm.ts.
#
#   AI_BASE_URL   .../v1  → protocolo OpenAI (requiere AI_API_KEY)
#                 .../api → API nativa de Ollama (compatibilidad hacia atrás)
#   AI_MODEL      modelo a usar; `auto` deja que el router elija y haga failover
#   AI_API_KEY    unified API key del router
#   AURA_API_KEY  token compartido con Aura para el puente /api/aura/*
#
# DIFERENCIA ENTRE ENTORNOS (deliberada):
#   local    → https://freellmapi.roquintc.app/v1   (el túnel; el router vive
#              en el servidor y no se levanta una segunda instancia)
#   servidor → http://freellmapi-freellmapi-1:3001/v1  (red interna de Docker,
#              evita dar la vuelta por internet y no depende del túnel)
#
# OJO con la URL interna: el host debe ser el NOMBRE DEL CONTENEDOR. Docker sólo
# crea el alias corto del servicio dentro de su propio proyecto compose, así que
# `freellmapi` a secas NO resuelve entre proyectos distintos.
AI_BASE_URL=https://freellmapi.roquintc.app/v1
AI_MODEL=auto
AI_API_KEY=tu-unified-api-key-de-freellmapi
AURA_API_KEY=pon-aqui-un-token-largo-para-aura

# ── Bot de AURA en Telegram ──────────────────────────────────
# Enlace que abren los botones "Abrir Aura" de la app. Se incrusta en el bundle
# del cliente durante el build, así que cambiarlo exige RECONSTRUIR la imagen.
#
# En local conviene apuntar a un bot de PRUEBAS: si los enlaces llevan al bot de
# producción, cualquier prueba termina escribiendo en los datos reales. Un bot
# distinto puede correr en paralelo, porque Telegram limita el getUpdates por
# token, no por usuario.
#
# Sin definir usa el bot de producción.
NEXT_PUBLIC_AURA_BOT_URL=https://t.me/Aura_RQC_Bot

