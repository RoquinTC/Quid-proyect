# ============================================================
# Variables de la RAÍZ del monorepo (secretos de servicios y Docker)
# ============================================================
#
# ¿DÓNDE VA CADA COSA?
#
# Hay dos archivos .env y conviene no mezclarlos, porque `docker compose`
# resuelve unos valores desde la raíz y otros desde Quid-App/.env:
#
#   ESTE archivo (raíz)      → secretos de servicios externos (Telegram, Groq,
#                              OpenRouter, Tavily, ElevenLabs) y parámetros de
#                              infraestructura (Postgres, puertos).
#
#   Quid-App/.env            → configuración de la APP: DATABASE_URL (que en
#                              Docker apunta al contenedor `postgres`),
#                              NEXTAUTH_*, AURA_API_KEY y el backend de IA
#                              (AI_BASE_URL / AI_MODEL / AI_API_KEY).
#                              docker-compose.yml lo carga con `env_file`.
#
# REGLA: una variable vive en UN solo archivo. Si aparece en los dos, el de la
# raíz gana en silencio y vas a depurar el valor equivocado durante una hora.

NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000

# Push Notifications VAPID keys
# Generar: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=tu-clave-publica-vapid
VAPID_PRIVATE_KEY=tu-clave-privada-vapid
VAPID_SUBJECT=mailto:tu@email.com

TELEGRAM_BOT_TOKEN=your-token
TELEGRAM_ALLOWED_USER_IDS=123456789
GROQ_API_KEY=your-key
OPENROUTER_API_KEY=your-key
GOOGLE_AI_KEY=your-key
TAVILY_API_KEY=your-key
FIREBASE_SERVICE_ACCOUNT_JSON=your-json
POSTGRES_DB=quid
POSTGRES_USER=quid
POSTGRES_PASSWORD=quid-local-dev
POSTGRES_PORT=5432

# Local PostgreSQL DATABASE_URL used only for migration tests.
# The current app still uses Quid-App/.env while SQLite remains active.
POSTGRES_DATABASE_URL=postgresql://quid:quid-local-dev@localhost:5432/quid?schema=public

# ── Backend de IA (va en Quid-App/.env, no acá) ──────────────
# Ollama se eliminó: agotaba la RAM del servidor. Ahora se usa un router
# OpenAI-compatible (FreeLLMAPI). Ver Quid-App/src/lib/ai/llm.ts y
# Quid-App/.env.example para el detalle. Resumen:
#
#   AI_BASE_URL   .../v1  → protocolo OpenAI (requiere AI_API_KEY)
#                 .../api → API nativa de Ollama (compatibilidad)
#   AI_MODEL      modelo; `auto` deja que el router elija y haga failover
#   AI_API_KEY    unified API key del router
#   AURA_API_KEY  token compartido con Aura para el puente /api/aura/*
#
# En local, AI_BASE_URL sirve el túnel (https://freellmapi.roquintc.app/v1),
# que funciona desde cualquier entorno. En el servidor se usa la URL interna de
# Docker para no dar la vuelta por internet.

